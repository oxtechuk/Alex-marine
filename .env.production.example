# ==============================================================================
# ALEX MARINE — PRODUCTION ENVIRONMENT CONFIGURATION (HOSTINGER / ANY CPANEL)
# ==============================================================================

APP_NAME="Alex Marine"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

# ------------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (Hostinger MySQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uXXXXXXXX_alexmarine
DB_USERNAME=uXXXXXXXX_dbuser
DB_PASSWORD=YourStrongDatabasePassword

# ------------------------------------------------------------------------------
# SESSION & CACHE CONFIGURATION
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=alex_marine_cache

# ------------------------------------------------------------------------------
# STORAGE & QUEUE CONFIGURATION
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ------------------------------------------------------------------------------
# EMAIL CONFIGURATION (Hostinger Webmail / SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@yourdomain.com
MAIL_PASSWORD=YourEmailPassword
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# VITE & FRONTEND
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
